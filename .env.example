# ── LA Space Studio Admin — environment ──────────────────────────────────
# Copy to .env and adjust. .env is git-ignored; this file is the template.
#
# Vite rules: only VITE_-prefixed variables reach browser code
# (import.meta.env.VITE_*), and they are baked in at build time — change one,
# rebuild. Per-mode files are read too: .env.development on `npm run dev`,
# .env.production on `npm run build`. .env.local overrides and is ignored.

# ── Dev server ───────────────────────────────────────────────────────────
VITE_DEV_PORT=5174
# Where the dev server forwards /api. Dev only — in production the API serves
# the panel at /admin on the same origin.
VITE_API_PROXY_TARGET=http://localhost:4000

# ── Mount path ───────────────────────────────────────────────────────────
# Where the panel is served. Sets Vite's `base` and the router's basename
# together, so they cannot drift. Leading and trailing slash.
VITE_BASE_PATH=/admin/

# ── API ──────────────────────────────────────────────────────────────────
# Where the browser sends API calls. Same-origin /api by default. Set an
# absolute origin only if the API lives on its own host — and allow this
# panel's origin in the API's CORS (ADMIN_ORIGIN in its .env).
VITE_API_BASE=/api
